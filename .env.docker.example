# Documents the environment variables the `app` and `worker` services need.
# docker-compose.yml sets these directly (dev-only, hardcoded values) via the
# shared `app-env` anchor — this file is just a reference, not consumed
# automatically. Swap the *_PASSWORD and APP_KEY values before using this
# anywhere that matters.

APP_NAME="Invoice App"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=invoices
DB_USERNAME=invoices
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
